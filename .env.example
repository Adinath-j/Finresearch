# Environment Configuration for Multi-Agent Financial Research System
# Milestone 1 and Milestone 2 Production & Development Profiles

APP_ENV=development
DEBUG=true
PORT=8000

# Relational Database: Supabase PostgreSQL (Production) / SQLite (Local)
# When DATABASE_URL is unset, system defaults to local persistent SQLite (documents.db)
DATABASE_URL=
SQLITE_DB_PATH=documents.db

# Storage Provider: 'local' (filesystem) or 'supabase' (private bucket)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=financial-documents

# Vector Database: Qdrant (Primary) / ChromaDB (Explicit Local Fallback)
# Set to 'qdrant' for production Qdrant Cloud or local Docker
# Set to 'auto' to probe Qdrant and fallback to persistent ChromaDB with clear health diagnostics
VECTOR_STORE_TYPE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=financial_chunks_openai_te3small_v1

# ChromaDB Alternative Collection (Local)
CHROMA_DB_DIR=chroma_db
CHROMA_COLLECTION=financial_chunks_local_minilm_v1

# Primary LLM Provider: OpenAI
# Set to 'openai' with OPENAI_API_KEY for live reasoning
# Set to 'mock' only for isolated deterministic unit tests without cloud credentials
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-6.1-sol
LLM_REASONING_EFFORT=high

# Primary Embeddings Provider: OpenAI
# text-embedding-3-small generates 1536-dimensional vectors
# When set to 'sentence-transformers' / 'local', generates 384-dimensional vectors
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Optional Responses API PDF Vision for complex non-extractable layout pages
OPENAI_ENABLE_PDF_VISION=false

# Document Ingestion & Chunking
SEED_DOCS_DIR=seed_documents
MAX_FILE_SIZE=23068672 # 22 MB in bytes
CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

# Durable Background Job Worker
WORKER_POLL_SECONDS=3
WORKER_MAX_RETRIES=3
